{
  // Configuración del Worker. En contenedor todo esto se sobrescribe con variables Messaging__*.
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      // MassTransit registra cada mensaje consumido en Information: útil, pero ruidoso.
      "MassTransit": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Messaging": {
    // Nombre del servicio en docker-compose y en Kubernetes; lo resuelve el DNS interno.
    "Host": "rabbitmq",
    "Port": 5672,
    "VirtualHost": "/",
    "Username": "dotnetlab",
    "Password": "",
    // Ruta del docker secret con la contraseña; tiene prioridad sobre Password.
    "PasswordFile": "",
    // Mensajes en vuelo por réplica. Ver el comentario de WorkerMessagingOptions: subirlo
    // sin subir el límite de memoria del pod provoca OOMKilled.
    "PrefetchCount": 4
  }
}
