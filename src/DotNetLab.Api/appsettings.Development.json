{
  // Solo se carga cuando ASPNETCORE_ENVIRONMENT=Development; se fusiona sobre appsettings.json.
  "Logging": {
    "LogLevel": {
      // Debug en desarrollo: interesa ver el detalle de cada resolución y cada medición.
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information"
    }
  },
  "Cache": {
    // En local no hay contenedor auxiliar: la sonda responde "deshabilitada" sin intentar el socket.
    "Enabled": false
  }
}
