@* Página que el Router muestra cuando ninguna ruta coincide (NotFoundPage en Routes.razor). *@
@page "/not-found"
@layout MainLayout

<PageTitle>Página no encontrada · DotNetLab</PageTitle>

<div class="panel">
    <p class="eyebrow">Error 404</p>
    <h1>Esta ruta no existe</h1>
    <p class="lede">El portal solo tiene dos secciones; probablemente buscabas una de estas.</p>

    <div class="hero-actions">
        <a class="btn btn-primary" href="modern-dotnet">Modern .NET y C#</a>
        <a class="btn" href="docker">Docker en producción</a>
    </div>
</div>
