{
  // Configuración del host Blazor. En contenedor se sobrescribe con variables Api__*.
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Messaging": {
    // "rabbitmq" activa la suscripción al bus para notificar por SignalR; cualquier otro valor
    // la deja apagada y la UI cae al respaldo por consulta periódica del estado del trabajo.
    // En local queda desactivada: el broker solo existe en docker-compose.
    "Transport": "disabled",
    "Host": "rabbitmq",
    "Port": 5672,
    "VirtualHost": "/",
    "Username": "dotnetlab",
    "Password": "",
    "PasswordFile": ""
  },
  "Api": {
    // URL del backend vista desde el PROCESO del frontend (no desde el navegador).
    // En docker-compose pasa a ser http://api:8080 mediante Api__BaseUrl.
    "BaseUrl": "http://localhost:5280",
    // Ruta del docker secret; vacía en local, donde la API tampoco valida clave.
    "SharedKeyFile": "",
    "SharedKey": "",
    // Debe coincidir con SharedKey:HeaderName de la API.
    "HeaderName": "X-Lab-Key"
  }
}
